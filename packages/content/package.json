{
  "name": "@shubhvela/content",
  "version": "0.1.0",
  "private": true,
  "description": "Shubhvela content corpus: rule snippets, glossary, lessons, festivals, vrats and UI strings in en / hi / bho (JSON, schema-validated).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "gen-tokens": "tsx scripts/gen-tokens.ts",
    "gen-tokens:check": "tsx scripts/gen-tokens.ts --check",
    "gen-festival-rules": "tsx scripts/gen-festival-rules.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
