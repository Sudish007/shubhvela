{
  "name": "@shubhvela/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Shubhvela Jyotish engine: vendored @prisri/jyotish fork + astronomy-engine, plus Shubhvela rules (pure TypeScript, no React).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:data": "tsx scripts/build-tz-table.ts && tsx scripts/build-gazetteer.ts",
    "design-samples": "tsx scripts/design-samples.ts",
    "build:verified": "tsx scripts/build-verified-dates.ts",
    "reference:check": "node reference/check.mjs",
    "reference:fetch:panchang": "node reference/fetch/drik-panchang.mjs",
    "reference:fetch:horizons": "node reference/fetch/jpl-horizons.mjs",
    "reference:fetch:kundali": "node reference/fetch/drik-kundali.mjs",
    "reference:fetch:astrosage": "node reference/fetch/astrosage-chart.mjs",
    "reference:fetch:festivals": "node reference/fetch/drik-festivals.mjs",
    "reference:fetch:matching": "node reference/fetch/drik-matching.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/opentype.js": "1.3.8",
    "moment-timezone": "^0.6.5",
    "opentype.js": "1.3.4",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "tz-lookup": "^6.1.25",
    "vitest": "^5.0.0"
  }
}
